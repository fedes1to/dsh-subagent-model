  "bugs": {
    "url": "https://git.fedesito.me/fedes1to/dsh-subagent-model/issues"
  },
  "type": "module",
  "main": "./index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "dsh-plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
